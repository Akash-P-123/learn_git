# TO Run the Docker Command and pull the container
docker run <Container_name:Specification>
docker pull <Container_name>
docker start  <Container_name or COntainer value>
docker stop  <Container_name or COntainer value>
docker run -p 0000:0000 -d --name <name> --net <network_name> <Container_Name>

#Trouble Shooting
docker logs
docker network -ls
docker logs <Name_of_the_Container_Value>
docker logs <Name_of_the_Container_Value> | tail 
docker logs <Name_of_the_Container_Value> - f 
docker exec -it <container_name_or_id> <shell_type>

# To check all the running containe
docker ps 
docker images 
docker ps -a

#To assign the port address 
docker run -p <local_port:Container_port> <COntainer_name>

#To Change the name of the container
docker run --name "Name_as_you_wish" <Img_name>

# To Create a Nerwork 
docker network create <Network_Name>

# To Declare the enviroment Variable 
Refer the Docker hub it gaves the env commands and use "- e" before it

# To Create a Docker Compose File ( Create a file name as .yaml)
" version: '3.8'
services:
  mongo:
    image: mongo
    ports:
      - 27017:27017
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: password

  mongo-express:
    image: mongo-express
    ports:
      - 8081:8081
    environment:
      ME_CONFIG_MONGODB_ADMINUSERNAME: admin
      ME_CONFIG_MONGODB_ADMINPASSWORD: pass
      ME_CONFIG_MONGODB_SERVER: mongo
"

# To run this Compose 
docker-compose -f name.yaml up
docker-compose -f name.yaml down
